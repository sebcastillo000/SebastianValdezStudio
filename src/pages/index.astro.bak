---
import ProyectosDestacados from \"../components/inicio/ProyectosDestacados.astro\";
---
/* Página de inicio (ruta "/"). Solo importa el Layout y ordena las secciones. */
import Layout from "../layouts/Layout.astro";
import Portada from "../components/inicio/Portada.astro";
import Proyectos from "../components/Proyectos.astro";
import SobreMi from "../components/SobreMi.astro";
import Contacto from "../components/Contacto.astro";
---

<Layout
  title="Sebastian Valdez Studio"
  description="Portafolio creativo de Sebastián Valdez: personajes, escenarios y procesos realizados a mano con plastilina."
>
  <Portada />
  <Proyectos />
  <SobreMi />
  <Contacto />
</Layout>
