---
/*
  Materiales y técnicas: solo imágenes.
  Las fotos empiezan apiladas en el centro y se separan en abanico
  mientras el usuario baja con el scroll (inspirado en el efecto de Aardman).

  La animación vive en src/scripts/animaciones.ts (función iniciarAbanico).
  Aquí solo marcamos el HTML:
    data-abanico         -> el escenario donde ocurre el efecto
    data-abanico-carta   -> cada imagen que se mueve
*/

// map() recorre la lista y crea una tarjeta por cada imagen.
const imagenes = [
  { src: "/images/personajes.jpg", alt: "Personajes modelados en plastilina" },
  { src: "/images/KANE.jpg", alt: "Escultura en plastilina del personaje Kane" },
  { src: "/images/detrasescenas.jpg", alt: "Fotografía detrás de escenas de un set de plastilina" },
  { src: "/images/SLASHER.jpg", alt: "Personaje Slasher preparado para animación" },
];
---

<section id="materiales-y-tecnicas" aria-label="Materiales y técnicas" class="overflow-hidden">
  <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 md:py-24">
    <div data-abanico class="relative mx-auto aspect-[4/5] max-w-md md:aspect-[16/6] md:max-w-none">
      {imagenes.map((imagen) => (
        <figure
          data-abanico-carta
          class="carta absolute top-1/2 left-1/2 m-0 aspect-[3/4] w-[44%] overflow-hidden rounded-8 border border-borde bg-superficie p-2 shadow-suave will-change-transform md:w-[23%]"
        >
          <img
            src={imagen.src}
            alt={imagen.alt}
            loading="lazy"
            class="h-full w-full rounded-[4px] object-cover"
          />
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  /* Posición antes de que cargue el JavaScript: apiladas en el centro. */
  .carta {
    transform: translate(-50%, -50%) scale(0.85);
  }
</style>
