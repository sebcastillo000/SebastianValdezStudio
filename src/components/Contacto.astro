---
/*
  Contacto: sección sencilla con invitación y datos a completar.
*/
import Seccion from "./ui/Seccion.astro";
---

<Seccion id="contacto" etiqueta="04" titulo="Contacto">
  <div class="max-w-2xl">
    <p class="text-lg text-gris-800">
      ¿Te interesa mi trabajo o quieres colaborar en un proyecto? Escríbeme y conversemos sobre
      personajes, escenarios y procesos creativos.
    </p>

    <p class="mt-6 font-mono text-xs tracking-widest text-gris-600 uppercase">
      Datos de contacto por completar
    </p>
  </div>
</Seccion>
